{
  "name": "hvcs-login",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright helper for capturing Taipower HVCS login state",
  "scripts": {
    "login": "node scripts/hvcs-login.js",
    "extract:dashboard": "node scripts/extract-dashboard.js",
    "hvcs:run": "bash scripts/run-hvcs.sh",
    "headless:run": "bash scripts/run-hvcs.sh",
    "hvcs:login": "bash scripts/run-hvcs.sh --mode=headless login",
    "hvcs:extract:dashboard": "bash scripts/run-hvcs.sh --mode=headless extract:dashboard",
    "hvcs:basic:all": "bash scripts/run-hvcs.sh --mode=headless basic:all",
    "hvcs:all": "bash scripts/run-hvcs.sh --mode=headless open:all-month",
    "hvcs:all:range": "bash scripts/run-hvcs.sh --mode=headless open:all-range",
    "hvcs:power:day": "bash scripts/run-hvcs.sh --mode=headless open:power-analyze",
    "hvcs:power:month": "bash scripts/run-hvcs.sh --mode=headless open:power-analyze-month",
    "hvcs:power:range": "bash scripts/run-hvcs.sh --mode=headless open:power-analyze-range",
    "hvcs:watch": "bash scripts/watch-hvcs-progress.sh",
    "open:cycle": "HVCS_TARGET_PAGE=cycle node scripts/extract-dashboard.js",
    "basic:all": "HVCS_TARGET_PAGE=all node scripts/extract-dashboard.js",
    "open:all-month": "HVCS_TARGET_PAGE=all_month node scripts/extract-dashboard.js",
    "open:all-range": "HVCS_TARGET_PAGE=all_range node scripts/extract-dashboard.js",
    "open:basic": "HVCS_TARGET_PAGE=basic node scripts/extract-dashboard.js",
    "open:energy_usage": "HVCS_TARGET_PAGE=energy_usage node scripts/extract-dashboard.js",
    "open:power-analyze": "HVCS_TARGET_PAGE=power_analyze node scripts/extract-dashboard.js",
    "open:power-analyze-month": "HVCS_TARGET_PAGE=power_analyze_month node scripts/extract-dashboard.js",
    "open:power-analyze-range": "HVCS_TARGET_PAGE=power_analyze_range node scripts/extract-dashboard.js",
    "open:price": "HVCS_TARGET_PAGE=price node scripts/extract-dashboard.js"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  }
}
